# Sunrise
b.{$WEB_DOMAIN},
c.{$WEB_DOMAIN},
cho.{$WEB_DOMAIN},
c4.{$WEB_DOMAIN},
a.{$WEB_DOMAIN},
api.{$WEB_DOMAIN},
osu.{$WEB_DOMAIN},
assets.{$WEB_DOMAIN} {
    # Compose publishes Sunrise only on the IPv4 loopback interface. Use the
    # literal address so systems that resolve localhost to ::1 do not produce
    # a 502 while the container itself is healthy.
    reverse_proxy 127.0.0.1:{$SUNRISE_SERVER_PORT:3912} {
        # Send exactly one client address. Caddy ignores untrusted inbound
        # X-Forwarded-For values when determining {client_ip}.
        header_up X-Forwarded-For {client_ip}
    }
}

# Sunset
{$WEB_DOMAIN} {
    reverse_proxy localhost:{$SUNSET_PORT:3090}
}

